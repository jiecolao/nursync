generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// USERS
// ============================================================

model User {
  userId String @id @map("user_id") @db.VarChar(64)

  facultyId String? @unique @map("faculty_id") @db.VarChar(20)

  lastName   String  @map("last_name") @db.VarChar(255)
  fastName   String  @map("fast_name") @db.VarChar(255)
  middleName String? @map("middle_name") @db.VarChar(255)
  suffix     String? @db.VarChar(5)

  genderId Int? @map("gender_id")

  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  gender  Gender?      @relation(fields: [genderId], references: [genderId])
  account UserAccount?

  @@map("Users")
}

// ============================================================
// USER ACCOUNTS
// ============================================================

model UserAccount {
  userAccId String @id @default(uuid(7)) @map("user_acc_id") @db.VarChar(36)

  userId String @unique @map("user_id") @db.VarChar(64)

  username String @unique @db.VarChar(64)
  hashPass String @map("hash_pass") @db.VarChar(255)

  status Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User             @relation(fields: [userId], references: [userId])
  role UserAccountRole?

  @@map("User_accounts")
}

model UserAccountRole {
  userAccId String   @unique @map("user_acc_id") @db.VarChar(36)
  roleId    Int      @map("role_id") @db.Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userAccount UserAccount @relation(fields: [userAccId], references: [userAccId])
  role        Role        @relation(fields: [roleId], references: [roleId])
  auditLogs   AuditLog[]

  @@id([userAccId, roleId])
  @@map("User_account_roles")
}

model Role {
  roleId       Int      @id @default(autoincrement()) @map("role_id")
  roleName     String   @unique @map("role_name") @db.VarChar(50)
  permissionId Int      @map("permission_id") @db.Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permission   Permission        @relation(fields: [permissionId], references: [permissionId])
  userAccounts UserAccountRole[]

  @@map("Roles")
}

model Permission {
  permissionId   Int     @id @default(autoincrement()) @map("permission_id")
  students_read  Boolean
  students_write Boolean
  user_read      Boolean
  user_write     Boolean
  logs_read      Boolean
  logs_write     Boolean

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles Role[]

  @@map("Permissions")
}

model AuditLog {
  auditUuid String @id @default(uuid()) @map("audit_uuid") @db.VarChar(36)
  userAccId String @map("user_acc_id") @db.VarChar(36)
  roleId    Int    @map("role_id") @db.Int
  action    String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  user_account_role UserAccountRole @relation(fields: [userAccId, roleId], references: [userAccId, roleId])

  @@map("Audit_logs")
}

// ============================================================
// STUDENTS
// ============================================================

model Student {
  studentUuid String @id @default(uuid(7)) @map("student_uuid") @db.VarChar(36)

  studentId String? @unique @map("student_id") @db.VarChar(20)

  lastName   String  @map("last_name") @db.VarChar(255)
  firstName  String  @map("first_name") @db.VarChar(255)
  middleName String? @map("middle_name") @db.VarChar(255)

  genderId Int?
  dob      DateTime?

  contactNo String? @map("contact_no") @db.VarChar(50)
  email     String? @db.VarChar(100)

  provincialAddr String? @map("provincial_addr") @db.Text
  cityAddr       String? @map("city_addr") @db.Text

  yrAdmitted  Int  @map("yr_admitted")
  yrResidency Int  @map("yr_residency")
  yrGraduated Int? @map("yr_graduated")

  isHd   Boolean @default(false) @map("is_HD")
  status Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  gender    Gender?           @relation(fields: [genderId], references: [genderId])
  documents StudentDocument[]

  @@map("Students")
}

// ============================================================
// STUDENT DOCUMENTS
// ============================================================

model StudentDocument {
  studentDocId String @id @map("student_doc_id") @db.VarChar(64)

  studentUuid String @map("student_uuid") @db.VarChar(255)
  docuId      Int    @map("docu_id") @db.Int

  filename String? @db.VarChar(255)
  filepath String? @db.VarChar(255)

  submittedAt DateTime? @map("submitted_at")

  docuStatusId Int @map("docu_status_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentUuid], references: [studentUuid])

  documentCategories DocumentCategories @relation(fields: [docuId], references: [docuId])

  documentStatus DocumentStatus @relation(fields: [docuStatusId], references: [docuStatusId])

  @@map("Student_Documents")
}

// ============================================================
// DOCUMENT CATEGORIES
// ============================================================

model DocumentCategories {
  docuId Int @id @map("docu_id") @db.Int

  docuName String @unique @map("docu_name") @db.VarChar(20)

  status Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  documents StudentDocument[]

  @@map("Document_categories")
}

model AuditLogs {
  auditUuid String   @id @default(uuid(7)) @map("audit_uuid") @db.VarChar(36)
  userId    String   @unique @map("user_id") @db.VarChar(64)
  role      String   @map("role") @db.VarChar(255)
  action    String   @map("action") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
}

// ============================================================
// DOCUMENT STATUS
// ============================================================

model DocumentStatus {
  docuStatusId Int @id @map("docu_status_id") @db.Int

  docuStatusName String @map("docu_status_name") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  documents StudentDocument[]

  @@map("Document_Status")
}

// ============================================================
// GENDERS
// ============================================================

model Gender {
  genderId Int @id @map("gender_id") @db.Int

  genderName String @map("gender_name") @db.VarChar(20)

  status Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users    User[]
  students Student[]

  @@map("Genders")
}
