# Docker Compose credentials (replace with unique values before production).
DB_PASSWORD=replace-with-a-unique-database-password
DB_ROOT_PASSWORD=replace-with-a-unique-root-password

# Authentication: generate a long random secret; never use the example in production.
JWT_SECRET=replace-with-a-long-random-secret

# Optional Docker Compose settings
WEB_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

# Optional application settings for running outside Docker
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
FRONTEND_PORT=5173
BACKEND_PORT=5151

# Gmail SMTP (use a Google App Password; never your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
